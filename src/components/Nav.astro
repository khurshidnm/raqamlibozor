---
import '../styles/nav.css';
import logo from '../assets/ui/logo.svg';
import Icon from './Icon.astro';
import type { Landing } from '../lib/content';
import { getLandingEntries } from '../lib/content';
import { localizeHref, switchLocalePath } from '../lib/locale';

interface Props {
  landing: Landing;
  siteName: string;
  home: string;
  defaultLocale: string;
}

const { landing, siteName, home, defaultLocale } = Astro.props;
const { nav, a11y } = landing.data;
/* In-page anchors (#bozorlar) only exist on the landing page; prefix them elsewhere. */
const current = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isHome = current === home;
const resolve = (href: string) =>
  href.startsWith('#') && !isHome ? `${home}${href}` : localizeHref(href, landing.id, defaultLocale);
const entries = await getLandingEntries();
const codes = entries.map((entry) => entry.id);
const languages = entries
  .map((entry) => ({
    code: entry.id,
    short: entry.id.charAt(0).toUpperCase() + entry.id.slice(1),
    name: entry.data.language,
    lang: entry.data.lang,
    href: switchLocalePath(current, entry.id, codes, defaultLocale),
    active: entry.id === landing.id,
  }))
  .sort((a, b) => Number(b.code === defaultLocale) - Number(a.code === defaultLocale) || a.code.localeCompare(b.code));
const active = languages.find((l) => l.active);
---

<header class="nav" id="nav">
  <div class="nav__bar">
    <a class="nav__logo" href={home} aria-label={siteName}>
      <img src={logo.src} width="95" height="33" alt={siteName} />
    </a>

    <nav class="nav__links" aria-label={a11y.mainMenu}>
      {nav.links.map((link) => (
        <a class="nav__link" href={resolve(link.href)}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="nav__actions">
      {languages.length > 1 && active && (
        <div class="lang">
          <button
            class="lang__btn"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label={`${active.name}`}
          >
            <Icon name="globe" />
            <span>{active.short}</span>
          </button>
          <ul class="lang__list">
            {languages.map((l) => (
              <li>
                <a href={l.href} hreflang={l.lang} lang={l.lang} aria-current={l.active ? 'true' : undefined}>
                  <span class="lang__code">{l.short}</span>
                  <span>{l.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <a class="nav__cta" href={resolve(nav.cta.href || '#boglanish')}>
        <Icon name="arrow" />
        <span>{nav.cta.label}</span>
      </a>
    </div>

    <button
      class="nav__menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="navPanel"
      aria-label={a11y.menuOpen}
      data-label-open={a11y.menuOpen}
      data-label-close={a11y.menuClose}
    >
      <Icon name="menu" class="icon--menu" />
      <Icon name="close" class="icon--close" />
    </button>

    <nav class="nav__panel" id="navPanel" aria-label={a11y.mainMenu}>
      {nav.links.map((link) => (
        <a href={resolve(link.href)}>{link.label}</a>
      ))}
      {languages.length > 1 && (
        <div class="nav__panel-lang">
          {languages.map((l) => (
            <a href={l.href} hreflang={l.lang} lang={l.lang} aria-current={l.active ? 'true' : undefined}>
              {l.name}
            </a>
          ))}
        </div>
      )}
    </nav>
  </div>
</header>

<script>
  import { initNav } from '../scripts/nav';
  initNav();
</script>
