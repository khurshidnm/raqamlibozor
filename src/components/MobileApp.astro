---
import { Image } from 'astro:assets';
import type { Landing } from '../lib/content';
import preview from '../assets/ui/mobile-app-home.jpg';
import '../styles/mobile-app.css';

interface Props {
  landing: Landing;
}

const { mobileApp } = Astro.props.landing.data;
const stores = mobileApp
  ? [
      { name: 'App Store', href: mobileApp.appStoreUrl, kind: 'apple' },
      { name: 'Google Play', href: mobileApp.googlePlayUrl, kind: 'play' },
    ].filter((store) => store.href)
  : [];
---

{mobileApp?.enabled && (
  <section class="mobile-app" id="mobil-ilova" aria-labelledby="mobile-app-title">
    <div class="mobile-app__copy">
      <span class="pill">{mobileApp.pill}</span>
      <h2 class="mobile-app__title" id="mobile-app-title">
        {mobileApp.title}
      </h2>
      <p class="mobile-app__description">{mobileApp.description}</p>
      <ul class="mobile-app__features">
        {mobileApp.features.map((feature) => (
          <li>
            <span aria-hidden="true">✓</span>
            {feature.text}
          </li>
        ))}
      </ul>
      <div class="mobile-app__downloads">
        {stores.map((store) => (
          <a class="mobile-app__store" href={store.href} target="_blank" rel="noopener noreferrer">
            <svg width="28" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              {store.kind === 'apple' ? (
                <path d="M17.05 12.04c.02 3.1 2.72 4.13 2.75 4.14-.02.07-.43 1.47-1.42 2.92-.86 1.25-1.75 2.5-3.15 2.53-1.37.03-1.82-.82-3.39-.82-1.57 0-2.06.8-3.36.85-1.35.05-2.38-1.35-3.25-2.6-1.78-2.57-3.14-7.26-1.31-10.43.91-1.57 2.54-2.57 4.32-2.59 1.35-.02 2.62.91 3.44.91.82 0 2.36-1.13 3.98-.97.68.03 2.57.27 3.78 2.04-.1.06-2.41 1.4-2.39 4.02ZM14.47 4.38c.72-.87 1.21-2.08 1.08-3.28-1.04.04-2.3.69-3.05 1.56-.67.77-1.26 2-1.1 3.17 1.16.09 2.35-.59 3.07-1.45Z" />
              ) : (
                <path d="M3.4 2.2 14 12 3.4 21.8a2 2 0 0 1-.4-1.2V3.4c0-.5.1-.9.4-1.2Zm12 8.5L5.7 1.8l12.5 7.1-2.8 1.8Zm0 2.6 2.8 1.8-12.5 7.1 9.7-8.9Zm1.4-1.3 3.5-2c1.5.9 1.5 3.1 0 4l-3.5-2Z" />
              )}
            </svg>
            <span>
              <small>{mobileApp.downloadLabel}</small>
              <strong>{store.name}</strong>
            </span>
          </a>
        ))}
      </div>
    </div>
    <div class="mobile-app__visual">
      <div class="mobile-app__halo" aria-hidden="true"></div>
      <div class="mobile-app__phone">
        <Image
          src={preview}
          alt={mobileApp.previewAlt}
          width={460}
          widths={[300, 460, 600]}
          sizes="(max-width: 809.98px) 240px, 280px"
          format="webp"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>
)}
