---
import NewsPostPage from '../../../components/NewsPostPage.astro';
import type { Landing, Settings } from '../../../lib/content';
import { getLandingEntries, getSettings } from '../../../lib/content';
import { getNews, type NewsPost } from '../../../lib/news';

export async function getStaticPaths() {
  const settings = await getSettings();
  const entries = (await getLandingEntries()).filter((entry) => entry.id !== settings.defaultLocale);
  const paths = [];
  for (const landing of entries) {
    for (const post of await getNews(landing.id)) {
      paths.push({ params: { locale: landing.id, slug: post.id }, props: { landing, settings, post } });
    }
  }
  return paths;
}

interface Props {
  landing: Landing;
  settings: Settings;
  post: NewsPost;
}

const { landing, settings, post } = Astro.props;
---

<NewsPostPage landing={landing} settings={settings} post={post} />
