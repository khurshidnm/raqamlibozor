---
import '../styles/markets-page.css';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import UzbekistanMarketMap from './map/UzbekistanMarketMap';
import type { Landing, Settings } from '../lib/content';
import { getLandingEntries, getMedia, localePath } from '../lib/content';
import { getMarkets, marketsPath, placeMarkets } from '../lib/markets';

interface Props {
  landing: Landing;
  settings: Settings;
}

const { landing, settings } = Astro.props;
const { map } = landing.data;
const home = localePath(landing.id, settings.defaultLocale);
const site = Astro.site ?? new URL(settings.siteUrl);
const path = marketsPath(landing.id, settings.defaultLocale);
const markets = placeMarkets(await getMarkets());
/* The map page exists in every language, so each one is an hreflang alternate. */
const alternates = (await getLandingEntries()).map((entry) => ({
  hreflang: entry.data.lang,
  path: marketsPath(entry.id, settings.defaultLocale),
}));

const og = await getMedia(settings.socialImage);
const ogImage = await getImage({ src: og.image, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 82 });

/* The contact form lives on the home page, so an anchor link is prefixed like the nav does. */
const ctaHref = map.invitation.cta.href || '#boglanish';
const invitation = {
  text: map.invitation.text,
  label: map.invitation.cta.label,
  href: ctaHref.startsWith('#') ? `${home}${ctaHref}` : ctaHref,
  note: map.invitation.note,
};
---

<Base
  settings={settings}
  landing={landing}
  alternates={alternates}
  xDefault={marketsPath(settings.defaultLocale, settings.defaultLocale)}
  title={map.seo.title}
  description={map.seo.description}
  ogImage={{ url: new URL(ogImage.src, site).href, width: 1200, height: 630, alt: og.alt || settings.siteName }}
  path={path}
>
  <div class="page">
    <Nav landing={landing} siteName={settings.siteName} home={home} defaultLocale={settings.defaultLocale} />
    <div class="shell">
      <main class="main map-page" id="main">
        <header class="map-page__head">
          <span class="pill pill--faq">{map.pill}</span>
          <h1 class="map-page__title">{map.title}</h1>
          <p class="map-page__desc">{map.description}</p>
        </header>
        <section class="map-page__frame" aria-label={map.strings.mapLabel}>
          <UzbekistanMarketMap
            client:load
            markets={markets}
            regions={map.regions}
            kinds={map.kinds}
            strings={map.strings}
            invitation={invitation}
          />
        </section>
      </main>
      <Footer landing={landing} defaultLocale={settings.defaultLocale} />
    </div>
  </div>
</Base>
