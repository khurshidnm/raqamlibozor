---
import '../styles/markets.css';
import type { Landing } from '../lib/content';
import { localizeHref } from '../lib/locale';

interface Props {
  landing: Landing;
  frames: number;
  defaultLocale: string;
}

const { landing, frames, defaultLocale } = Astro.props;
const { markets, a11y } = landing.data;
const external = /^https?:\/\//.test(markets.cta.href);
---

<section class="markets" id="bozorlar">
  <header class="markets__head">
    <h2 class="markets__title">{markets.title}</h2>
    {markets.cta.href && (
      <a
        class="btn-sm"
        href={localizeHref(markets.cta.href, landing.id, defaultLocale)}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener' : undefined}
      >
        {markets.cta.label}
      </a>
    )}
  </header>
  <div class="globe" id="globe" data-frames={frames} data-src="/earth/earth-{i}.webp">
    <img
      class="globe__fallback"
      src="/earth/earth-00.webp"
      width="1600"
      height="900"
      alt={a11y.globeLabel}
      loading="lazy"
      decoding="async"
    />
    <canvas class="globe__canvas" width="1600" height="900" role="img" aria-label={a11y.globeLabel}></canvas>
  </div>
</section>

<script>
  import { initGlobe } from '../scripts/globe';
  initGlobe();
</script>
