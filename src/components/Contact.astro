---
import '../styles/contact.css';
import { Picture } from 'astro:assets';
import type { Landing } from '../lib/content';
import { getMedia } from '../lib/content';
import { UZ_DISPLAY_MAX_LENGTH } from '../lib/phone';

interface Props {
  landing: Landing;
  endpoint: string;
}

const { landing, endpoint } = Astro.props;
const { contact } = landing.data;
const bg = await getMedia(contact.image);
const { form, sent } = contact;
---

<section class="contact" id="boglanish">
  <div class="cta">
    <Picture
      class="cta__bg"
      src={bg.image}
      alt={bg.alt ?? ''}
      formats={['avif', 'webp']}
      fallbackFormat="jpeg"
      width={Math.min(1242, bg.image.width)}
      widths={[800, 1242, 1800, 2484].filter((w) => w <= bg.image.width)}
      sizes="(max-width: 809.98px) 941px, 1242px"
      loading="lazy"
      decoding="async"
    />
    <div class="cta__content">
      <h2 class="cta__title">{contact.title}</h2>
      <form
        class="cta__form"
        id="demoForm"
        novalidate
        data-endpoint={endpoint}
        data-msg-invalid={form.invalid}
        data-msg-network={form.networkError}
        data-msg-success={form.success}
        data-msg-sending={form.sending}
      >
        <label class="sr-only" for="demoPhone">
          {form.label}
        </label>
        <input
          class="cta__input"
          id="demoPhone"
          name="phone"
          type="tel"
          inputmode="tel"
          autocomplete="tel"
          placeholder={form.placeholder}
          maxlength={UZ_DISPLAY_MAX_LENGTH}
          aria-describedby="demoMsg"
        />
        <div class="cta__hp" aria-hidden="true">
          <label for="demoWebsite">Website</label>
          <input id="demoWebsite" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button class="btn-sm" type="submit">
          {form.submit}
        </button>
      </form>
      <p class="cta__msg" id="demoMsg" role="status" aria-live="polite"></p>
    </div>
  </div>
</section>

<dialog class="sent" id="demoSent" aria-labelledby="demoSentTitle" aria-describedby="demoSentText">
  <form method="dialog" class="sent__x-form">
    <button class="sent__x" type="submit" aria-label={sent.close}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
  </form>
  <div class="sent__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24">
      <path d="m5 12.5 4.5 4.5L19 7.5"></path>
    </svg>
  </div>
  <h3 class="sent__title" id="demoSentTitle">
    {sent.title}
  </h3>
  <p class="sent__text" id="demoSentText">
    {sent.text}
  </p>
  <p class="sent__note">{sent.note}</p>
  <form method="dialog">
    <button class="btn btn--green sent__close" type="submit">
      {sent.close}
    </button>
  </form>
</dialog>

<script>
  import { initDemoForm } from '../scripts/demo-form';
  initDemoForm();
</script>
