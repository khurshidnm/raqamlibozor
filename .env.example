# Public origin of the deployed site (overrides settings.siteUrl)
SITE_URL=https://raqamli-bozor.uz

# Set to true on production deploys: fails the build when the form endpoint or SITE_URL is missing
STRICT_BUILD=false

# Optional: overrides the demo-request endpoint from Site settings
PUBLIC_DEMO_ENDPOINT=

# Only for hosted Keystatic (GitHub storage mode, see README › CMS)
# KEYSTATIC=true
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
