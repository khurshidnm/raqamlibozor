---
import '../styles/footer.css';
import type { Landing } from '../lib/content';
import { localizeHref, localePath } from '../lib/locale';
import logo from '../assets/ui/logo.svg';
import { withYear } from '../lib/text';

interface Props {
  landing: Landing;
  defaultLocale: string;
}

const { landing, defaultLocale } = Astro.props;
const { footer } = landing.data;
const href = (value: string) => localizeHref(value, landing.id, defaultLocale);
---

<footer class="footer">
  <div class="footer__top">
    <a class="footer__brand" href={localePath(landing.id, defaultLocale)} aria-label={footer.brand}>
      <img src={logo.src} width="118" height="41" alt={footer.brand} loading="lazy" decoding="async" />
    </a>
    <div class="footer__cols">
      {footer.columns.map((col) => (
        <ul class="footer__col">
          {col.links.map((link) => (
            <li>{link.href ? <a href={href(link.href)}>{link.label}</a> : <span>{link.label}</span>}</li>
          ))}
        </ul>
      ))}
    </div>
  </div>
  <div class="footer__bottom">
    <hr class="footer__line" />
    <div class="footer__legal">
      <p>{withYear(footer.copyright)}</p>
      <p class="footer__made">
        {footer.madeBy.href ? (
          <a href={footer.madeBy.href} rel="noopener">
            {footer.madeBy.label}
          </a>
        ) : (
          footer.madeBy.label
        )}
      </p>
    </div>
  </div>
</footer>
