---
import '../styles/global.css';
import '../styles/loader.css';
import Loader from '../components/Loader.astro';
import type { Landing, Settings } from '../lib/content';
import type { Alternate } from '../lib/locale';
import { canonicalUrl, normalizeTwitterHandle, robotsDirectives } from '../lib/seo';
import { trackingBodyStart, trackingHead } from '../lib/tracking';
import { PAGE_ZOOM_INLINE } from '../lib/inline-scripts';

export interface Preload {
  imagesrcset: string;
  imagesizes: string;
  media?: string;
}

interface Props {
  settings: Settings;
  landing: Landing;
  /** Equivalent pages in other languages (include the page itself) for hreflang. */
  alternates?: Alternate[];
  /** Path used for `hreflang="x-default"`; omitted when there is no language-neutral equivalent. */
  xDefault?: string;
  /** Keeps utility pages such as the 404 out of search results. */
  noindex?: boolean;
  title: string;
  description: string;
  /** Social-share title/description when they should differ from the search snippet. */
  ogTitle?: string;
  ogDescription?: string;
  /** Canonical URL override from the CMS. */
  canonical?: string;
  /** ISO date for article pages. */
  modifiedTime?: string;
  /** Absolute URL of the share image. */
  ogImage: { url: string; width: number; height: number; alt: string };
  jsonLd?: Record<string, unknown>[];
  preloads?: Preload[];
  /** Path of this page, e.g. "/" or "/ru/". */
  path: string;
  ogType?: 'website' | 'article';
  /** ISO date for article pages. */
  publishedTime?: string;
  /** Path of an RSS feed to advertise. */
  rss?: string;
}

const {
  settings,
  landing,
  alternates = [],
  xDefault,
  noindex = false,
  title,
  description,
  ogTitle = '',
  ogDescription = '',
  canonical: canonicalOverride = '',
  modifiedTime,
  ogImage,
  jsonLd = [],
  preloads = [],
  path,
  ogType = 'website',
  publishedTime,
  rss,
} = Astro.props;
const site = Astro.site ?? new URL(settings.siteUrl);
const canonical = canonicalUrl(path, site, canonicalOverride);
const { seo, tracking } = settings;
const robots = robotsDirectives({ siteIndexable: seo.indexable, noindex });
const twitterSite = normalizeTwitterHandle(seo.twitterSite);
const verification = [
  ['google-site-verification', seo.verification.google],
  ['yandex-verification', seo.verification.yandex],
  ['msvalidate.01', seo.verification.bing],
  ['facebook-domain-verification', seo.verification.facebook],
  ['p:domain_verify', seo.verification.pinterest],
].filter(([, content]) => content);
const shareTitle = ogTitle || title;
const shareDescription = ogDescription || description;
/* Analytics only on the deployed site, never in `astro dev`. */
const headTags = import.meta.env.PROD ? trackingHead(tracking) : '';
const bodyTags = import.meta.env.PROD ? trackingBodyStart(tracking) : '';
const a11y = landing.data.a11y;
---

<!doctype html>
<html lang={landing.data.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={PAGE_ZOOM_INLINE} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={new URL(alt.path, site).href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, site).href} />}

    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {alternates
      .filter((alt) => alt.hreflang !== landing.data.lang)
      .map((alt) => (
        <meta property="og:locale:alternate" content={alt.hreflang.replace('-', '_')} />
      ))}
    <meta property="og:site_name" content={settings.siteName} />
    <meta property="og:locale" content={landing.data.lang.replace('-', '_')} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={ogImage.url} />
    <meta name="twitter:image:alt" content={ogImage.alt} />
    {twitterSite && <meta name="twitter:site" content={twitterSite} />}
    {verification.map(([name, content]) => (
      <meta name={name} content={content} />
    ))}
    {seo.customMeta.map((meta) => (
      <meta name={meta.name} content={meta.content} />
    ))}

    <meta name="theme-color" content={settings.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icons/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    {rss && <link rel="alternate" type="application/rss+xml" title={settings.siteName} href={rss} />}

    <link rel="preload" href="/fonts/gilroy-bold.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/gilroy-medium.woff2" as="font" type="font/woff2" crossorigin />
    {preloads.map((p) => (
      <link rel="preload" as="image" imagesrcset={p.imagesrcset} imagesizes={p.imagesizes} media={p.media} />
    ))}

    {headTags && <Fragment set:html={headTags} />}
    {jsonLd.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item).replaceAll('<', '\\u003c')} />
    ))}
  </head>
  <body>
    {bodyTags && <Fragment set:html={bodyTags} />}
    <Loader label={settings.siteName} />
    <a class="skip-link" href="#main">
      {a11y.skipToContent}
    </a>
    <slot />
    <script>
      import { initPageZoom } from '../scripts/page-zoom';
      import { initAppear } from '../scripts/appear';
      import { initLoader } from '../scripts/loader';
      initPageZoom();
      /* Reveal animations start once the loader is gone, so they are not wasted behind it. */
      void initLoader().then(initAppear);
    </script>
  </body>
</html>
