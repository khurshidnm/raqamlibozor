{
  "name": "raqamli-bozor-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Raqamli Bozor marketing site: Astro + TypeScript static site with a Payload CMS (cms/)",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "astro dev",
    "cms": "npm --prefix cms run dev",
    "cms:install": "npm --prefix cms install --legacy-peer-deps",
    "cms:import": "npm --prefix cms run import",
    "content:pull": "npm --prefix cms run pull",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "prepare": "node scripts/protect-leads.mjs",
    "verify": "npm run check && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
