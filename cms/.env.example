# Required: long random string used to sign admin sessions
PAYLOAD_SECRET=change-me
# Dev default is a local SQLite file. Set a Postgres URL in production.
DATABASE_URL=
# Public URL of this CMS (used in admin links)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# Extra browser origins allowed to POST leads, comma separated (settings.siteUrl is always allowed)
LEADS_ALLOWED_ORIGINS=
# First admin created by `npm run import` when no user exists
ADMIN_EMAIL=
ADMIN_PASSWORD=
